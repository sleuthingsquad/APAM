from tkinter import *
import math

# constants
PINK = "#e2979c"
RED = "#e7305b"
GREEN = "#9bdeac"
YELLOW = "#f7f6dd"
FONT_NAME = "Courier"
WORK_MIN = 7
SHORT_BREAK = 5
LONG_BREAK = 15
reps = 0
my_timer = None

# Timer Reset


def reset_timer():
    window.after_cancel(my_timer)
    canvas.itemconfig(timer_text, text="00:00")
    top_text.config(text="Timer")
    tick_mark.config(text="")
    global reps
    reps = 0

# Timer mechanism


def start_timer():

    global reps
    reps += 1

    work_secs = WORK_MIN
    short_break_secs = SHORT_BREAK
    long_break_secs = LONG_BREAK

    if (reps % 8) == 8:
        timer(int(long_break_secs))
        top_text.config(text="Break", fg=RED)
    elif (reps % 2) == 0:
        timer(int(short_break_secs))
        top_text.config(text="Break", fg=PINK)
    else:
        timer(int(work_secs))
        top_text.config(text="Work", fg=GREEN)



# Countdown mechanism


def timer(count):
    num_min = math.floor(count / 60)
    min_sec = count % 60
    if min_sec < 10:
        min_sec = f"0{min_sec}"

    canvas.itemconfig(timer_text, text=f"{num_min}:{min_sec}")
    if count > 0:
        global my_timer
        my_timer = window.after(1000, timer, count-1)
    else:
        start_timer()
        all_checks = ""
        for check in range(math.floor(reps/2)):
            all_checks += "✔"

        tick_mark.config(text=all_checks)

# GUI Setup


window = Tk()
window.title("Pomodoro App")
window.config(padx=100, pady=50, bg=YELLOW)

canvas = Canvas(width=200, height=224, bg=YELLOW, highlightthickness=0)
tomato = PhotoImage(file="tomato.png")
canvas.create_image(100, 112, image=tomato)

timer_text = canvas.create_text(110, 130, text="00:00", fill="white", font=(FONT_NAME, 24, "bold"))
canvas.grid(column=2, row=2)

start_button = Button(text="START", font=("Arial", 9, "normal"), command=start_timer)
start_button.grid(column=1, row=4)

reset_button = Button(text="RESET", font=("Arial", 9, "normal"), command=reset_timer)
reset_button.grid(column=3, row=4)

top_text = Label(text="Timer", font=(FONT_NAME, 35, "bold"), bg=YELLOW, fg=GREEN)
top_text.grid(column=2, row=1)

tick_mark = Label(fg=GREEN, bg=YELLOW, font=(FONT_NAME, 15))
tick_mark.grid(column=2, row=5)


window.mainloop()
