# Import Tkinter
import tkinter

window = tkinter.Tk()
window.title("Miles to Kms")
window.minsize(width=200, height=200)
window.config(padx=20, pady=20)

my_label = tkinter.Label(text="is equal to")
my_label.grid(column=1, row=2)
my_label.config(padx=10, pady=20)

miles_label = tkinter.Label(text="Miles")
miles_label.grid(column=3, row=1)

km_label = tkinter.Label(text="Km")
km_label.grid(column=3, row=2)

m_input = tkinter.Entry(width=10)
m_input.grid(column=2, row=1)

output = tkinter.Label(text="0")
output.grid(column=2, row=2)

def change_output():
    our_input = float(m_input.get())
    value = our_input * 1.6
    value = round(value, 2)
    output.config(text=f"{value}")


calculate_button = tkinter.Button(text="Calculate", command=change_output)
calculate_button.grid(column=2, row=3)

window.mainloop()
